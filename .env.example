# =============================================================================
# Edge AI System Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js Backend
# -----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=5000
BACKEND_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# AI Engine (Python FastAPI)
# -----------------------------------------------------------------------------
AI_ENGINE_PORT=8000
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Telemetry Collection
# -----------------------------------------------------------------------------
# Path to compiled C++ telemetry daemon (relative to backend/)
DAEMON_PATH=../system-agent/cpp-core/build/telemetry_daemon
# Path to Python fallback collector (relative to backend/)
COLLECTOR_PATH=../system-agent/collector.py
# How often to poll metrics (milliseconds)
TELEMETRY_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# Remediation Safety
# -----------------------------------------------------------------------------
# If true, every remediation plan requires explicit user approval before execution
REMEDIATION_REQUIRE_APPROVAL=true
# How long (ms) an approved-but-not-yet-executed plan remains valid
REMEDIATION_PLAN_EXPIRY_MS=300000

# =============================================================================
# system-agent/cpp-core/.gitignore
# =============================================================================

# CMake / Make build output — regenerated by cmake -B build && cmake --build build
build/

# CMake generated files that sometimes land outside build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Compiled object files and binaries
*.o
*.a
*.so
*.out

# Editor artefacts
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db
